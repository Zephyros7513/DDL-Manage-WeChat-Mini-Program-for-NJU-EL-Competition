.team-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 220rpx;
  padding: 28rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #143f3b, #146b63 58%, #4779a8);
  color: #fffdfa;
}

.eyebrow {
  color: rgba(255, 255, 255, 0.7);
  font-size: 23rpx;
  font-weight: 700;
}

.team-title {
  width: 430rpx;
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 850;
  line-height: 1.18;
}

.team-sub {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
}

.invite {
  width: 128rpx;
  margin: 0;
  background: #f2d06b;
  color: #143f3b;
}

.mini-btn {
  height: 56rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 10rpx;
  background: #e4eee8;
  color: #146b63;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 56rpx;
}

.team-tools {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.tool-card {
  aspect-ratio: 1;
  padding: 24rpx;
  border-radius: 16rpx;
  color: #fffdfa;
  box-shadow: 0 12rpx 26rpx rgba(48, 44, 35, 0.08);
}

.tool-card.edit-members {
  background: linear-gradient(135deg, #4779a8, #8cc7b1);
}

.tool-card.new-team {
  background: linear-gradient(135deg, #d96b52, #f2bf4e);
  color: #24211b;
}

.tool-icon {
  width: 62rpx;
  height: 62rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.28);
  font-size: 28rpx;
  font-weight: 850;
  line-height: 62rpx;
  text-align: center;
}

.tool-title {
  margin-top: 38rpx;
  font-size: 34rpx;
  font-weight: 850;
}

.tool-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  opacity: 0.78;
}

.team-progress {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 16rpx;
  padding: 22rpx;
  border-left: 8rpx solid #f2bf4e;
}

.progress-title {
  margin-bottom: 6rpx;
  font-size: 29rpx;
  font-weight: 800;
}

.progress-num {
  color: #146b63;
  font-size: 42rpx;
  font-weight: 850;
}

.mini-btn::after {
  border: 0;
}

.team-tabs {
  width: 100%;
  white-space: nowrap;
}

.team-tab {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  margin-right: 12rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #e8e3d8;
  color: #665d50;
  font-size: 25rpx;
  font-weight: 750;
}

.team-tab.active {
  background: #146b63;
  color: #fffdfa;
}

.member-strip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 18rpx;
  overflow-x: auto;
}

.member {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  min-width: 90rpx;
}

.avatar,
.member-add {
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background: #e7efe9;
  color: #146b63;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 62rpx;
  text-align: center;
}

.member text {
  color: #665d50;
  font-size: 22rpx;
}

.member-add {
  margin: 0;
  padding: 0;
  border: 2rpx dashed #8cc7b1;
  background: transparent;
  font-size: 34rpx;
}

.member-add::after {
  border: 0;
}

.shared {
  margin-bottom: 16rpx;
  padding: 22rpx;
  border-left: 8rpx solid #4779a8;
}

.shared-top {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.shared-title {
  margin-bottom: 8rpx;
  font-size: 31rpx;
  font-weight: 800;
}

.members {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.members text {
  min-width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #e7efe9;
  color: #146b63;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 56rpx;
  text-align: center;
}

.step-board {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 18rpx;
}

.team-step {
  min-height: 96rpx;
  padding: 14rpx;
  border-radius: 10rpx;
  background: #f7f1e8;
  color: #4f4a43;
}

.team-step.done {
  background: #dcefe9;
  color: #146b63;
}

.team-step text {
  display: block;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.25;
}

.team-step view {
  margin-top: 8rpx;
  color: #827a70;
  font-size: 22rpx;
}

.bar {
  height: 12rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #ebe5da;
}

.bar-fill {
  height: 100%;
  border-radius: 12rpx;
  background: #146b63;
}

.shared-actions {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
  margin-top: 18rpx;
}

.delete-btn {
  background: #f9e1d9;
  color: #a83d2b;
}

.empty {
  padding: 28rpx;
  color: #827a70;
}

.template-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.template-tip {
  margin: -4rpx 0 16rpx;
  color: #827a70;
  font-size: 24rpx;
  line-height: 1.4;
}

.template {
  min-height: 190rpx;
  padding: 22rpx;
  border-left: 8rpx solid #8cc7b1;
}

.template:nth-child(2n) {
  border-left-color: #f2bf4e;
}

.template:nth-child(3n) {
  border-left-color: #4779a8;
}

.template-icon {
  margin-bottom: 14rpx;
  font-size: 40rpx;
}

.template-title {
  margin-bottom: 8rpx;
  font-size: 29rpx;
  font-weight: 800;
}

.editor-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  padding: 24rpx;
  background: rgba(18, 22, 20, 0.42);
}

.team-editor {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  padding: 24rpx;
}

.task-editor {
  padding-bottom: 30rpx;
}

.editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.editor-title {
  font-size: 34rpx;
  font-weight: 850;
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #ede6da;
  color: #665d50;
  font-size: 36rpx;
  line-height: 56rpx;
}

.close-btn::after {
  border: 0;
}

.field {
  margin-bottom: 18rpx;
}

.field text {
  display: block;
  margin-bottom: 10rpx;
  color: #665d50;
  font-size: 24rpx;
  font-weight: 700;
}

.field input {
  min-height: 74rpx;
  padding: 0 18rpx;
  border-radius: 10rpx;
  background: #f4efe6;
  color: #20211f;
  font-size: 28rpx;
  line-height: 74rpx;
}

.field textarea {
  width: 100%;
  min-height: 190rpx;
  padding: 18rpx;
  border-radius: 10rpx;
  background: #f4efe6;
  color: #20211f;
  font-size: 27rpx;
  line-height: 1.45;
}

.picker-value {
  min-height: 74rpx;
  padding: 0 18rpx;
  border-radius: 10rpx;
  background: #f4efe6;
  color: #20211f;
  font-size: 28rpx;
  line-height: 74rpx;
}

.field-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.half {
  min-width: 0;
}

.save-btn {
  margin-top: 8rpx;
}
