.month-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  padding: 12rpx 2rpx 26rpx;
}

.eyebrow {
  color: #827a70;
  font-size: 23rpx;
  font-weight: 700;
}

.month-title {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 850;
}

.legend {
  display: grid;
  grid-template-columns: 18rpx auto 18rpx auto 18rpx auto;
  gap: 8rpx;
  align-items: center;
  color: #827a70;
  font-size: 22rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.low { background: #a7d7bd; }
.mid { background: #f2bf4e; }
.high { background: #d96b52; }

.week-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 12rpx;
  color: #827a70;
  font-size: 22rpx;
  text-align: center;
}

.calendar {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  padding: 14rpx;
}

.day {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 1;
  border-radius: 10rpx;
  background: #f4efe6;
  color: #776f65;
}

.day .num {
  font-size: 27rpx;
  font-weight: 750;
}

.day.today {
  outline: 4rpx solid rgba(20, 107, 99, 0.24);
}

.load-low {
  background: #dff0e7;
  color: #146b63;
}

.load-mid {
  background: #fff0c7;
  color: #996100;
}

.load-high {
  background: #f9e1d9;
  color: #a83d2b;
}

.load {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  min-width: 28rpx;
  height: 28rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.76);
  font-size: 19rpx;
  font-weight: 800;
  line-height: 28rpx;
  text-align: center;
}

.mini-task {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 16rpx;
  padding: 20rpx;
}

.mini-title {
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.empty {
  padding: 28rpx;
  color: #827a70;
}
