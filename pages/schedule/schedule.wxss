.schedule-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 10rpx 2rpx 22rpx;
}

.eyebrow {
  color: #827a70;
  font-size: 23rpx;
  font-weight: 700;
}

.schedule-title {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 850;
}

.schedule-sub {
  width: 500rpx;
  margin-top: 10rpx;
  color: #827a70;
  font-size: 24rpx;
  line-height: 1.45;
}

.toolbar {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
  padding: 16rpx;
  margin-bottom: 22rpx;
}

.mini-btn {
  height: 56rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 10rpx;
  background: #e4eee8;
  color: #146b63;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 56rpx;
}

.mini-btn::after {
  border: 0;
}

.danger-btn,
.delete-btn {
  background: #f9e1d9;
  color: #a83d2b;
}

.schedule-scroll {
  width: 100%;
}

.schedule-grid {
  display: grid;
  grid-template-columns: 128rpx repeat(7, 150rpx);
  min-width: 1178rpx;
  border-top: 1rpx solid #ece5db;
  border-left: 1rpx solid #ece5db;
  background: #fffdfa;
}

.corner,
.day-head,
.period-cell,
.course-cell {
  border-right: 1rpx solid #ece5db;
  border-bottom: 1rpx solid #ece5db;
}

.corner,
.day-head {
  position: sticky;
  top: 0;
  z-index: 1;
  height: 76rpx;
  background: #f4efe6;
  color: #2f332f;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 76rpx;
  text-align: center;
}

.period-cell {
  min-height: 128rpx;
  padding: 18rpx 8rpx;
  background: #f8f4ed;
  text-align: center;
}

.period-name {
  color: #20211f;
  font-size: 25rpx;
  font-weight: 800;
}

.period-time {
  margin-top: 8rpx;
  color: #827a70;
  font-size: 19rpx;
  line-height: 1.2;
}

.course-cell {
  min-height: 128rpx;
  padding: 12rpx;
  background: #fffdfa;
}

.course-cell.filled {
  background: #dcefe9;
}

.course-name {
  color: #146b63;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 1.2;
}

.course-meta {
  margin-top: 6rpx;
  color: #665d50;
  font-size: 20rpx;
  line-height: 1.2;
}

.empty-cell {
  color: #c0b6a8;
  font-size: 36rpx;
  font-weight: 300;
  line-height: 96rpx;
  text-align: center;
}

.today-card {
  margin-bottom: 16rpx;
  padding: 20rpx;
}

.today-title {
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.empty {
  padding: 28rpx;
  color: #827a70;
}

.editor-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  padding: 24rpx;
  background: rgba(18, 22, 20, 0.42);
}

.editor {
  width: 100%;
  padding: 24rpx;
}

.editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.editor-title {
  font-size: 34rpx;
  font-weight: 850;
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #ede6da;
  color: #665d50;
  font-size: 36rpx;
  line-height: 56rpx;
}

.close-btn::after {
  border: 0;
}

.field {
  margin-bottom: 18rpx;
}

.field text {
  display: block;
  margin-bottom: 10rpx;
  color: #665d50;
  font-size: 24rpx;
  font-weight: 700;
}

.field input {
  min-height: 74rpx;
  padding: 0 18rpx;
  border-radius: 10rpx;
  background: #f4efe6;
  color: #20211f;
  font-size: 28rpx;
  line-height: 74rpx;
}

.field-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.half {
  min-width: 0;
}

.editor-actions {
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  gap: 14rpx;
  margin-top: 8rpx;
}
