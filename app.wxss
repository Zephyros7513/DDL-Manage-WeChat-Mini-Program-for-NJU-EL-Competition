page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f4f7f1 0%, #f7f1e8 46%, #eef5f4 100%);
  color: #20211f;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 160rpx;
}

.section {
  margin-top: 28rpx;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  color: #2f332f;
  font-size: 34rpx;
  font-weight: 850;
}

.muted {
  color: #827a70;
}

.card {
  background: #fffdfa;
  border: 1rpx solid rgba(42, 40, 35, 0.06);
  border-radius: 16rpx;
  box-shadow: 0 12rpx 28rpx rgba(48, 44, 35, 0.07);
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.btn {
  height: 78rpx;
  border-radius: 12rpx;
  background: #146b63;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 78rpx;
}

.btn::after {
  border: 0;
}

.ghost-btn {
  background: #e8eee9;
  color: #146b63;
}

.danger {
  background: #f9e1d9;
  color: #a83d2b;
}

.warning {
  background: #fff0c7;
  color: #996100;
}

.steady {
  background: #dcefe9;
  color: #146b63;
}

.quiet {
  background: #e8e3d8;
  color: #665d50;
}
